#include <iostream>
using namespace std;

class matran{
	private:
		int sohang;
		int socot;
		int data[100][100];
	public:
		Matran(){
			sohang = 0;
			socot = 0;
		}
		void nhap(){
			cout <<"Nhap so hang: "; //in - xuat ra du lieu
			cin >> sohang; //nhap du lieu 
			cout <<"Nhap so cot: ";
			cin >> socot;
			
			cout <<"Nhap cac phan tu cua ma tran:\n";
			for(int i = 0; i < sohang; i++){
				for(int j = 0; j < socot; j++){
					cout << "A[" << i << "][" << j << "] = ";
					cin >> data[i][j];
				}
			}
		}
		void xuat(){
			for(int i = 0; i < sohang; i++){
				for(int j = 0; j < socot; j++){
					cout << data[i][j] << "\t";
				}
				cout << endl;
			}
		}
